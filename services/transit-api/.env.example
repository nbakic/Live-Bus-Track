# Copy to .env on the server and fill in as needed. docker-compose reads it.
# All values are OPTIONAL — the app has sane defaults for ZET feeds.

# Enables /v1/plan (GraphHopper transit routing). Without it that one
# endpoint returns 503; everything else works.
GRAPHHOPPER_API_KEY=

# Override only if ZET changes its feed endpoints.
# ZET_GTFS_RT_URL=https://www.zet.hr/gtfs-rt-protobuf
# ZET_GTFS_STATIC_URL=https://www.zet.hr/gtfs-scheduled/latest
# RT_CACHE_TTL=10
